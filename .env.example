# Example environment file. Copy this to .env and fill values.
# Do NOT commit your real secrets. Use CI/CD secret storage for production keys.

# Node / API
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
# These credentials match the local docker-compose.yml file.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.aknrrosogpoxuqtqweik.supabase.co:5432/postgres"

# Supabase REST API. Used by infra/scripts/load-courses-supabase.ts.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Public frontend base URL (Next.js automatically exposes NEXT_PUBLIC_ vars to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth / Security
JWT_SECRET=super_secret_jwt_key_for_local_dev

# Google OAuth2 (Calendar)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/calendar/callback
FRONTEND_URL=http://localhost:3000

# AI Assistant
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
